export const meta = {
  name: 'retrux-r11-lanes',
  description: 'Round 11: build the ENV (Blender bake v9), HOLD (A2 rebuild) and ICE (Cycles twin) lanes in parallel worktrees, judge each adversarially, one fix + re-judge',
  whenToUse: 'Retrux hero round 11 lane build; args {SP, MAIN}',
  phases: [
    { title: 'Build', detail: 'lane builders in their own worktrees; heavy work only through the shared slot' },
    { title: 'Judge', detail: 'independent adversarial judge per lane with its own captures and gate verdicts' },
    { title: 'Fix', detail: 'one fixer per failing lane, then a re-judge' },
  ],
}

const SP = args.SP
const MAIN = args.MAIN
const SPEC = MAIN + '/notes/round11/SPEC.md'
const SLOT = 'node ' + SP + '/slot/slot.mjs run'

// ---- resume notes and lead decisions (added 21:30 after the first run hit the account usage limit at 19:07) ----
const STOP_NOTE = `An abrupt stop (the account usage limit or a network outage) can happen at any moment and kills the agent without warning. Append your state to WORK/LOG.md after every sub-step (what changed, numbers, what is next) and keep LANE/HANDOFF.md current, so the next agent can continue exactly where you stopped.`

const PERF_NOTE = `Frame-time measurements: run perf_probe through the slot with the env SLOT_BG=0 in front of the slot command (e.g. SLOT_BG=0 ${SLOT} '<lane>:perf' -- node ...): it runs that one command at normal QoS (background QoS throttles every build to 5-8 fps and makes the numbers meaningless). Timing runs only, never Blender or long captures. Use at least 6 interleaved A/B pairs (baseline :5173 vs your lab, same tier, scale and window), only while the 1-min load is below 6, and report medians and the worst frame.`

const ENV2_NOTE = `

RESUME NOTE (lead, 15 Nov 03:50): this step was cut off twice: at 19:08 by the usage limit (before any edit) and at about 22:38 by a network outage, after substantial work (LakeMirror.ts planar mirror, Water.ts BAKED_MIRROR bump model, encode_sky_m9.py + public/hero/sky_world.exr, HeroEngine.ts / assets.ts changes). WORK/LOG.md ends with: NEXT: check gain 1.15 at rest, then p06 / pointer extremes / q03 for plausibility; then perf; then wisp. Read LOG.md and git -C LANE status / git diff, and continue from that exact state; do not redo finished work.

LEAD DECISIONS for this step:
(a) Step 1 replaced the mip-bias DOF with a textureGrad emulation (?envlod=bias is the old one); keep whichever measures closer to the projected plates and to the reference.
(b) Before the wisp card is drawn, re-bake BG.001 and V2_Massif from no-wisp plate crops as step 1's open issue says (render_plates_m9.py nowisp, comp_env_m9.py only=BG.001,V2_Massif), otherwise the wisp doubles. Verify at rest that the wisp is single and lands where the plates had it (diff map vs the baseline).
(c) Tone or clamp the equirect's saturated sun disc before the lake mirror uses it.
(d) The two remaining ridge specks: try removing the self-overlapping fold faces in prep or a polygon offset; re-check at rest and from every pointer spot.
(e) The planar mirror must not break the frame budget: if the extra pass costs more than E-G3 allows at a tier, keep today's re-aimed reflection at that tier and document it (T0 is protected).
(f) ${PERF_NOTE}
${STOP_NOTE}`

const ICE2_NOTE = `

RESUME NOTE (lead, 15 Nov 03:50): this step was cut off twice, at 19:07 by the usage limit and at about 22:38 by a network outage; the second attempt continued through sub-step s16 (orb converged on the twin: defaults uR11Orb (0,0,0,0), uR11OrbB.x 1, Orb.ts under ORB_R11) and its log says: Next: T8 joints and T6 outlines (silhouette captures), then p06 hue, T9 shards, I-G3 / I-G4. Continue from there. Background of the first attempt: It left substantial uncommitted work in the lane (IceMaterial.ts +493 lines, Rings.ts +27, RenderPipeline.ts +4) and logged sub-steps s01-s08 in WORK/LOG.md (smooth tilt field instead of the Voronoi chisel; IceColor tint once per pass; the orb in the reflection lookup and its mirror image in the lake; lookup roughness growing per internal bounce, made the default). Do NOT start over: read WORK/LOG.md from the step-2 entries on and git -C LANE diff, re-measure the current state at q00 / q03 / p06 against the twin, then continue down the target list (T8 quarter joints, T6 outlines, the remaining Table-3 misses, then I-G3 and I-G4). First make sure ?ice=r10 restores the old look bit-identically (add the switch now if the first attempt has not).

LEAD DECISIONS for this step:
(a) Ring A's in-plane phase at rest is being fixed in the hold lane (its quarter joints will move to F000's x 584 / 878). Do not change any pose here; render the joints in the quarters' own frame so they follow whatever pose the rings get.
(b) ${PERF_NOTE} Measure T1 and T0. T0 may keep a cheaper ice path if the new one breaks its budget (say so).
${STOP_NOTE}`

const HOLD2_TASK = `YOUR STEP (2 of 2): finish SPEC 4.2. Read LANE/HANDOFF.md and WORK/LOG.md first (your previous step: 56 of 65 H-G1 checks pass; its result is below).

RESUME NOTE (lead, 15 Nov 03:50): a first attempt at this step was cut off at about 22:38 by a network outage after most of the work: ring A's in-plane phase -22.5 deg (A_PHASE_DEG, aPhaseFromUrl, Rings.tune.aLoopPhaseDeg; joints verified at the reference bars; press / release swing checked), the H-G1 run caps/final5 at 64 of 65 (the miss: F358 orb 11 % visible, limit 10), H-G2 exact silhouettes inside at all three sizes. Read WORK/LOG.md to the end and git -C LANE diff, finish what is left (the F358 orb miss if it can be fixed without regressions, the final H-G1..H-G5 re-run with fresh captures, HANDOFF.md), and do not redo finished work.

(1) LEAD DECISION: ring A's in-plane phase at rest. The ice lane's Cycles twin, posed exactly like the engine at q00, shows ring A's quarter joints (dark vertical bars in band A) at x 666 / 799, while the reference F000 shows them at x 584 / 878. The idle tumble comes from silhouette mocap (ringMocap.ts, captured from Default Loop.mp4), which cannot see a symmetric ring's spin, so A's in-plane phase is arbitrary and about 45 deg off. Measure the joint bars in the reference loop (MAIN/hero-pipeline/reference/ref_F000.png, loop_F000 / F015 / F030 / F045.png, and the Default Loop video under MAIN/refs/videos for more frames), confirm they behave like ring A's quarter joints under an in-plane rotation of A, and fit A's in-plane phase (a constant offset, plus a rate correction if the bars drift differently over the loop) so the engine's joints land on the reference's at rest and through the loop. Evidence: ${SP}/work/ice/ICE_TARGETS.md (section 1.3 difference 2 and target T8) and ${SP}/work/ice/cmp/q00_twin_ref_eng.png (twin | F000 | engine). In the engine the joints are where the quarter meshes Circle028-031 meet; a debug capture with the quarters in flat colours gives their screen x. This changes the rest pose only in A's in-plane phase. Put it behind its own switch ?aphase=r10 (the old phase, bit-identical); ?hold=r10 must still restore the complete round-10 behaviour (old phase included). With the new phase the press, the A2 arrangement and the release must still meet H-G1..H-G3: no extra quarter swing at the pop, the release still lands on today's whirl, no flips.

(2) The remaining H-G1 misses (A-T too long at its right end on F402 / F404 / F420, A-R's left edge at F402 / F404, F402 open sky, F384 A-T bottom edge, F358 right block, F358 orb 12 % visible): try the hinge-about-the-left-cap idea and whatever the side-by-sides suggest. Keep a change only when the side-by-side and the table both improve and nothing else regresses. Look at the live hold as a whole as well (sheets of the sequence F332-F472, engine over reference): it must read as the reference's legible exploded opening, continuous, nothing tangled.

(3) LEAD DECISION: H-G2 counts the exact silhouette (what the visitor sees); report the stock probe_holdbounds bounding-box numbers next to it for information.

(4) Re-run H-G1..H-G5 with fresh captures at the end. H-G5 now reads: rest identical to MAIN except ring A's in-plane phase; with ?aphase=r10 rest is identical within grain. Typecheck. Stop your lab.

${PERF_NOTE}
${STOP_NOTE}`

const JUDGE_RESUME = {
  env: `RESUME NOTE (lead, 15 Nov 09:00): a previous attempt at this judgement started 06:59 and was cut off at 07:03 by the usage limit after only reading the documents (WORK/judge1/verdict_draft.md). Start the verification fresh; keep writing the draft as you go.`,
  ice: `RESUME NOTE (lead, 15 Nov 09:00): a previous attempt at this judgement was cut off at about 07:05 by the usage limit. Its partial work is in WORK/judge1/ (verdict_draft.md with region numbers and findings (a)-(f): aliased camouflage islands on oblique bands, a closed contour capsule in band A at q00, black dots on the p06 vertical arc, no frost texture, q03 too pale / neutral and p06 ring B too light, the hold orb's busy lavender rim; crops in judge1/cmp/, tools in judge1/tools/). Read it, re-check each finding yourself (look at the crops), then continue with what it lists as next: the sweep (both labs), a temporal crawl sequence, the pointer spots, T0 / T2, the press-start joint fade and perf.`,
}
// judge:hold's completed round-1 verdict (15 Nov 06:5x), injected so a resume does not re-run that judge (the resume cache is prefix-based)
const HOLD_V1 = {"lane": "hold", "pass": false, "lens_score": 7.4, "gates": [{"gate": "H-G1 A2 section 10 checklist (F358, F384, F402-F404, F420, F440-F444, F452-F453, F456, F460)", "verdict": "FAIL", "evidence": "Judge's own live presses (real pointer events, frozen clock, exact 60 Hz steps) at 6 press moments (tau 0/0.5/1/1.8/2.6/3.4), with the reference cursor at (798,569) and tp = (F-330.5)/30 per A2 section 0. Measured on exact ID silhouettes rendered with the ice vertex shader (displacement included). judge1/HG1_lane_check.txt: 62-66 of 80 automatic rows pass per press moment (384/480 total); the F420 slit row fails at all 6 (mask). Misses: F358 orb 11.2-12.3% visible (limit 10%; still 11.3% at the builder's tp 0.9), B box (474-481,123-126,940-954,640-645) vs (500,168,935,622) +-25, extent 724-728x517-522 vs 710x454 +-40, B angle -50.4..-50.7. F384 C lens 411-418 px wide (ref ~340). F402/F404 bottom 616-628 (limit 615), orb 69.1-70.6% (70-80). F420 A-T x1 787-795 (765+-20), A-R y0 119-125 (148+-20), A-B x0 669-674 (698+-20), slit 0 px (25-35 px at y 410-440). F452 diagonal gaps 21-25 (25-60; ref 35-60). F452/F453 inner whirl lost: B 341-382 x 344-363 face-on (ref ~370x275, tilted ~40 deg). Passing rows: F404 A-R slab -44.6 deg; F420 gaps 103/91/4/1, radii 337/296/359/304, lens box (396,298,933,512), side arcs lean '\\'; F440/F444 rows; F452/F453 quarters at 12/3/6/9 (+-0.0 deg), r 215-226; F456 closed 411x413; F460 A 399x401; continuity (side pair CW 1.13 deg/frame with no reversal, no mid-span crossing, one lid). The builder's 65/65 is not reproducible: it used vertex boxes without displacement at tp=(F-331)/30 and had no slit or whirl rows."}, {"gate": "H-G2 probe_holdbounds worst-case extents inside the frame (exact silhouette, lead decision 1)", "verdict": "PASS", "evidence": "judge1/HG2_exact.txt, caps/g2_*: exact displaced silhouettes sampled every 0.1 s over tp 0.8-3.75 plus 7 release samples, 16 press moments per viewport. 1440x766: worst top 9 (tp 3.6), bottom 741 (tr 0.05), left 283, right 1180. 1280x800: 67 / 718. 1920x1080: 41 / 1018. Pointers pinned at 6 edges and corners (1440x766): top 8, bottom 742. Holds to 11 s: 1440 top 10-15, bottom 734-740; 1280 top 72, bottom 717; 1920 top 47, bottom 1016. Everything is inside the frame, touching only as the reference does at F436-F444."}, {"gate": "H-G3 probe_interact: click inert, no step >15 deg, re-press continuity, sequence continuous / slow / never frozen / one lid", "verdict": "FAIL", "evidence": "Click inert in both stock probe_interact runs (caps/probe_interact.txt: drivers 0, never holding). Stock hold segment 15.58 and 15.00 deg/frame (MAIN 13.14 / 12.25), so the 900 deg/s clamp was reached. Motion study with the engine loop stopped (caps/mot2_lane vs mot2_main; 16 press moments; probe_interact sequence) counts press moments with frames AT the clamp: charge 2/16 (ring C), release 0/16 (max 14.69), re-press 6/16, release after re-press 5/16 (MAIN: 4, 3, 12, 5). At tau 0, ring C's axis swings 15 deg/frame for 18 consecutive frames (~270 deg in 0.3 s), then ring B's axis 8-12.5 deg/frame for 12 frames (tools/axis_an.mjs on caps/repress/rep_motion.json). Short presses released 0.1-0.3 s into the hold whip at 3/8 press moments (short_press_clamps.txt). The r11 camera moves in a velocity staircase (background shift 6.3 | 24.4 25.3 24.9 | 4.9x6 | 0.9 px/frame against the reference's smooth bell 7.9 13.3 39.5 19.1 8.6 5.7 4.2). Passing parts: never frozen (least motion per 0.5 s: A 80, B 19.6, C 43.5, D 43.5 deg+px), exactly one lid F372-F448, sequence sheets judge1/sheets/seq_a-c.jpg continuous."}, {"gate": "H-G4 ?hold=r10 restores round-10 exactly", "verdict": "PASS", "evidence": "tools/jcmp.mjs (engine loop stopped; time, ring clock, orb plasma frame and grain frame pinned; shards hidden), lane ?hold=r10 vs MAIN, 30 shots: q00-q03, 9 pointer spots, p04-p08 debug poses, and live F358/F384/F420/F440/F453/F460 at 2 press moments. Every piece, camera and orb world matrix is identical (d=0, caps/hg4/log.txt) and the pixels are bit-identical: mean 0.0000, max 0 (judge1/HG4_pixels.txt)."}, {"gate": "H-G5 nothing outside the hold changed (rest q00-q03 + pointer spots; lead decision 2: only ring A's in-plane phase)", "verdict": "PASS", "evidence": "Lane ?aphase=r10 vs MAIN on q00-q03 and 9 pointer spots: bit-identical (judge1/HG5_aphase_pixels.txt). Default lane vs MAIN: only ring A's 4 pieces differ, each by exactly 22.50 deg about ring A's own axis (q00, q02, ptr_left). B, C, D, camera and orb matrices are identical (caps/hg5_def/log.txt). Pixels: mean 0.20-0.35/255, max 82-122, all on ring A."}, {"gate": "Typecheck (SPEC rule 10)", "verdict": "PASS", "evidence": "In LANE/retrux-web, tsc --noEmit -p tsconfig.hero.json and -p . both exit 0 with no errors."}, {"gate": "Perf T1 interleaved A/B (lead decision 4; not an H-gate)", "verdict": "FAIL", "evidence": "INCONCLUSIVE, not a demonstrated regression. 6 interleaved pairs, 06:21-06:36, SLOT_BG=0, 1-min load 2.3-5.4 at each pair start (judge1/perf/runs.txt, summary.txt). Medians MAIN/lane: rest 32.0/25.4 fps, hold 23.5/28.1, collapse 26.5/32.5. Per-pair lane/MAIN medians 0.753 / 0.939 / 0.866 (range 0.39-1.65). Worst frame MAIN 66.7 ms, lane 100.1 ms (pair 4, a contended run at load 5.4). The same MAIN build spans 18.7-40.4 fps at rest, and the rest path (identical except one quaternion multiply) reads 0.75, so the noise exceeds the 10% budget. CPU microbenchmark (caps/cpu_bench.txt): an engine update costs 0.02-0.03 ms in both builds. Re-measure GPU fill on a quiet machine."}], "findings": [{"severity": "major", "title": "Release F452-F456: the inner rings snap face-on into a concentric bullseye; the reference's tilted whirl is gone (regression vs r10)", "evidence": "At all 6 press moments, B at F452/F453 measures 341-382 x 344-363 px (aspect 0.94-1.0, face-on). The reference has B ~370x275, tilted ~40 deg. MAIN r10 keeps the whirl at 3 of 6 (457x301, 454x300, 452x275). See judge1/crops/rel_lane_main_ref.png (rows F452/F456/F460; columns lane | MAIN | ref) and caps/holdseq_lane/sheet_4.jpg. QC round 6 had removed exactly this 'target' look. The HANDOFF line 'the F453 whirl and the F460 eye are today's' does not match what renders.", "fix_hint": "In r11, B/C/D hand back through wI (0.02-0.34 s) to the plain face-on alignment, because the r10 release-whirl terms sit in the skipped `!r11 && d.expandPose > 0` path. Give releaseParams an inner-ring release target: keep wI to ~0.45 s, steer B to ~40 deg tilt (C ~40, D ~38, cf. Rings.tune dRelSnapDeg) at tr 0.30-0.33, then to the F460 eye (B face-on, D a band) by tr 0.57. Alternatively, run the r10 inner-ring release block in r11 starting from the r11 lid pose. Gate: B aspect <= 0.8 at F452."}, {"severity": "major", "title": "F420 lens has no slit: the orb is sealed between the lids, only a 25 px cap shows", "evidence": "The ID mask caps/seq_lane/seq26_F420.mask.txt shows visible orb only in rows 283-307 (x 680-790) and none at y 410-440. Orb visible 3.6-4.9% at 6 press moments; F416-F428 likewise show only the cap. The reference has a 30 px glowing slit at y 410-440 (x 600-830) plus a tiny cap, ~15% visible, and that slit is the brightest feature of the main sustain frame. The lane's lens reads as a dull closed glass cylinder (judge1/crops/F420_lens_lane_over_ref.png). The A2 section 10 F420 row requires the slit.", "fix_hint": "At tp 2.8-3.25, open a 25-35 px gap between B's lower lip and C/D's upper rim: raise B's lid via rhoB/betaB at 2.97, and keep C/D lower or less flat via psiC/psiD amplitude or phase. Verify with an ID mask that the visible orb includes rows 410-440 and the cap shrinks to <= 10 px."}, {"severity": "major", "title": "r11 camera dolly follows the piecewise-linear EXPAND_CAM/RELEASE_CAM keys, so its speed changes in hard steps (new; r10 was smooth)", "evidence": "Background shift per frame (judge1/tools/bgshift.py, left strip x 0-300, same method on all three). Reference F353-F362: 5.7 7.9 13.3 39.5 19.1 8.6 5.7 4.2 3.2 2.7 (a smooth bell). Lane: 6.1 6.3 | 24.4 25.3 24.9 | 4.9 4.9 4.9 4.8 4.8 4.8 | 0.9 (x3.9 at F355, /5 at F358, /5 at F364). MAIN: smooth but late, peak 14 at F358-F359. Camera step per 60 Hz frame jumps 171->631 mm at F354.5, 625->121 at F357.5 and 121->22 at F363.5 (caps/seq_lane/seq26_motion.json). The release decelerates 626->396 mm, then plateaus at 142/100/50/27/20/0 (caps/cam_lane). The whole frame jolts at the pop and again at F364. Cause: the CameraRig.ts r11 branch lerps camExpand directly.", "fix_hint": "r11 only, so r10 stays bit-identical: sample the camera curves with a C1 monotone cubic (HoldR11's Curve class: new Curve(EXPAND_CAM).at(tp), same for RELEASE_CAM), or apply a 2-3 frame critically damped smoothing with lead compensation. Target the reference's bell (peak ~F356, then ~19/9/6/4/3 px/frame), then recheck the F358 orb radius and F364 framing."}, {"severity": "major", "title": "Re-press and charge still whip rings at the 900 deg/s turn clamp (re-press continuity)", "evidence": "Measured with the engine loop stopped, 16 press moments, probe_interact sequence (caps/mot2_lane). Press moments with frames at the clamp: charge 2/16 (ring C, 3-4 frames), re-press 6/16, release after re-press 5/16 (MAIN 12/16 and 5/16, so this is inherited but not fixed). At tau 0, ring C's axis swings 15 deg/frame for 18 consecutive frames (~270 deg in 0.3 s), then ring B's axis swings 8-12.5 deg/frame for 12 frames (tools/axis_an.mjs; crops/repress_whip_k204_232.png, crops/release2_whip_k260_280.png). Presses released 0.1-0.3 s into the hold whip on release at 3/8 press moments (short_press_clamps.txt). At tau 2.6 the charge turns A at 780 deg/s and C at 852 deg/s into the eye (the reference's eye pass is ~255 deg/s). The stock probe_interact hold segment reads 15.58. Note: the 108 deg one-frame 'flip' in caps/mot_lane is a probe artefact (frozen dt=0 frames skip the limiter); the loop-stopped numbers above are the live behaviour.", "fix_hint": "Make a re-press during the release continue from the current pose: keep the hold vector and the tumble freeze instead of blending them to 0 in the click window, and resume holdParams at the matching tp. Re-latch the alignment side (faceSign) at every press so the charge's frontal pass always takes the nearest face. Cap the charge alignment at ~300 deg/s instead of relying on MAX_TURN."}, {"severity": "minor", "title": "F358 pop: an orb crescent shows above the bar, B jumps to full length in one frame and ends 40-45 px high, side blocks fly about 2x the reference speed", "evidence": "Orb 11.2-12.3% visible at all press moments (limit 10%); the visible part is a white crescent above the A-R bar, where the reference shows only a lower-left patch. B's y0 jumps 177->125 between F357 and F358 (caps/cam_lane). At A2 timing the B box is (474-481,123-126,940-954,640-645) vs (500,168,935,622) +-25 (it passes at tp 0.9). Extent 724-728x517-522 (710x454 +-40). Side blocks move 48-74 px/frame at F356-F357, then 8-12 px/frame (reference ~40). See crops/F358_t26_t00_ref.png.", "fix_hint": "Ramp bsplit over 3-4 frames (~1.4 at tp 0.9). Raise or thicken the A-R bar at the pop (rollA/pushR/tiltR) until the orb cap is covered. Ease pushT/pushB's 0.05->0.55 jump over 3-4 frames."}, {"severity": "minor", "title": "Key-frame boxes miss the A2 tolerances by 3-13 px on the displaced silhouette", "evidence": "F420: A-T x1 787-795 (765 +-20), A-R y0 119-125 (148 +-20), A-B x0 669-674 (698 +-20). F402/F404 bottom 616-628 (limit 615). F384 C lens 411-418 px wide (ref ~340; the reference's A-R slab covers the lens' right end, ours does not). F402/F404 orb 69.1-70.6% (70-80). Source: judge1/HG1_lane_check.txt.", "fix_hint": "Refit against the exact silhouette (the jprobe ID render with the ice vertex shader) at A2 timing, not against vertex boxes: trim A-T's right end (hngT), A-R's top cap and A-B's left end by ~10 px, and lift the bottom arc ~13 px at F404."}, {"severity": "minor", "title": "Sustain quarter paths go out-in-out (A2 R4: no contraction while held), with speed bursts", "evidence": "Centre-line midpoint radius (caps/seq_lane) vs A2 section 6.1. A-R: 296 at F396 (ref 194), 257 at F404 (ref 240), 359 at F420 (ref 375). A-L: 329 at F404 (ref 280), 296 at F420 (ref 311). A-B: 330 at F404, 304 at F420. Pivot speeds reach 9-11.5 px per 30 fps frame at F376-F380 and F400 (A2 R11: <= 3-6). The cause is per-frame key fits: pushR 0.38/0.10/0.569 at tp 2.17/2.43/2.97, pushL 0.431/0.8/0.48, tiltR -6/-20/-11.", "fix_hint": "Refit push/slide/tilt in one joint fit over all key frames against the A2 section 6.1 trajectories, constraining the midpoint radius to be monotone between F372 and F444."}, {"severity": "minor", "title": "F452: ring A's quarters close a frame or two early", "evidence": "F452 diagonal gaps are 21-25 px at all press moments; the reference has 45/35/50/60 at F452 and 25-40 at F453. Radius r 222-226 is fine. Source: HG1_lane_check.txt.", "fix_hint": "Set gapRel to ~0.30 / 0.28 m at tr 0.25 / 0.30 (now 0.24 / 0.21), keeping the close by F456."}, {"severity": "minor", "title": "Charge in-betweens: rings whip into the eye, hold it ~0.25 s, then A pitches into the X while the reference keeps its yaw tumble", "evidence": "judge1/crops/charge_336_352.png (engine row over reference): in the engine, F336-F344 stay face-on and A then flattens vertically (pitch). The reference's A narrows sideways (yaw) at idle tumble speed. Ring speeds from caps/seq_lane/seq26_motion.json: A 13 deg/step at F335.5, 2.6 at F340.5, 4.6 at F347. This matches the builder's open item 2.", "fix_hint": "Route the r11 charge target through the tumble (e.g. an extra rollA key near 90 at tp 0.3-0.45) and drop the frontal hold, so A keeps moving through the eye at ~170-250 deg/s."}, {"severity": "minor", "title": "Shards cross the lens centre during the sustain (outside this lane's code)", "evidence": "At F420, three large shards sit over the lens and orb (crops/F420_lens_lane_over_ref.png, caps/sweep_lane/sw_hold_TR.png). The reference keeps the shard belt just outside A (A2 R10). Shards.ts was not touched by this lane.", "fix_hint": "For the lead/ICE lane: widen the hold belt radius, or keep shards behind the lens depth while camExpand > 0.5."}, {"severity": "nit", "title": "Release hand-back is late and B's lid drifts too little", "evidence": "The tumble resumes around F468-F473 (reference F463-F465), because wA and freeze fade until tr 1.0 (RELEASE_LEN_R11 1.05); see caps/holdseq_lane/sheet_4.jpg, F468. B's lid centroid moves only y 353.8->417.8 over F404-F444 (~60 px; reference ~120).", "fix_hint": "Once the camera and re-press fixes remove the clamp risk, move the hand-back to 0.45-0.8 s and roughly double betaB's span."}, {"severity": "nit", "title": "HANDOFF claims are not reproducible", "evidence": "H-G1 '65 of 65' vs this judge's 62-66 of 80 plus a failed slit row. 'The F453 whirl ... are today's' vs the bullseye that renders. '15.25 is normalization jitter' vs the clamp being reached at 2/16 charge and 6/16 re-press moments.", "fix_hint": "Update HANDOFF with silhouette-based numbers at A2 timing and with the limits above."}, {"severity": "nit", "title": "Info for the lead: UI overlap and portrait framing (A2 section 9.3 decision)", "evidence": "The open frame passes behind the headline, and at F436-F444 (bottom 741) behind 'Scroll to Explore' (y 693-712); see caps/sweep_lane/sw_hold_TR.png. Portrait 390x844 crops the side arcs but keeps the core centred (crops/portrait_strip.png). No environment doubling during the faster lunge (crops/lunge_env_left_lane_over_main.png). The only console error is the env_baked.json 404, which MAIN also has.", "fix_hint": "The lead decides between (a) matching the reference and (b) a UI-safe cap, and whether the hold FOV should pull back on mobile."}], "summary": "The HOLD lane fails. H-G1 and H-G3 fail; H-G2, H-G4, H-G5 and typecheck pass; perf is inconclusive. There are 4 major findings and the lens score is 7.4.\n\nThe r11 rebuild is a real step up from r10: the arrangement is deterministic (extents within ~10 px across 6 press moments), and the sequence from the charge through the pop, slab cluster, portal and open frame to the 12/3/6/9 release follows the video. The switches back are bit-exact: `?hold=r10` and `?aphase=r10` match MAIN on 30 and 13 shots, and the default differs only by ring A's 22.50 deg in-plane turn. Exact silhouettes stay inside 1440x766, 1280x800 and 1920x1080 at every press moment, pointer edge and 11 s hold.\n\nIt is not yet the video:\n1. The release's inner rings snap into a face-on bullseye at F452-F456 instead of the tilted whirl, which is a regression of the QC round 6 fix.\n2. The F420 lens has no glowing slit; the orb shows only as a cap.\n3. The r11 camera moves on linear keys, so it jolts at F355, F358 and F364 (background speed 6 | 25 | 5 | 0.9 px/frame against the reference's smooth bell).\n4. Re-presses and some charges still whip rings at the 900 deg/s clamp (ring C turns ~270 deg in 0.3 s at tau 0).\n\nSmaller misses: the pop's orb crescent (11-12% visible) and over-long B, box misses of 3-13 px, out-in-out quarter paths at F396-F420, early-closing F452 gaps, and the charge in-betweens. Perf could not be judged: the same MAIN build ranged 18.7-40.4 fps at rest under contention, and the CPU cost is negligible in both builds.\n\nEverything is in /private/tmp/claude-501/-Users-muhamadrifaldi-Documents-GitHub-retrux-hero-rnd/a0f5735b-9a7f-477e-9b57-6de40ca5644b/scratchpad/work/hold/judge1/ (verdict_draft.md, the tools, caps, crops and sheets). The lab on :5175 was started and stopped by this judge; :5173 was not touched."}

const FIX_RESUME = {
  hold: `RESUME NOTE (lead, 15 Nov 09:00): a previous attempt at this fix was cut off at about 07:03 by the usage limit. Read the "Fix round 1" section of WORK/LOG.md to its end and WORK/fix/: it reproduced finding 3 (the dolly speed steps) and changed the camera, and its log says next: the release's inner whirl (finding 1), the F452 gaps (finding 8), F460, the tumble resume (finding 11). Check that the lane still typechecks, then continue from that state; do not redo finished work.`,
}

const LEAD_DECISIONS = `Lead decisions that apply in this round (they override the SPEC where they differ):
(1) HOLD, H-G2 counts the exact silhouette (what the visitor sees). The stock probe_holdbounds bounding-box corners overshoot tilted arcs by 20-50 px and are reported for information only.
(2) HOLD may change the rest pose in exactly one way: ring A's in-plane phase, so its quarter joints match F000 (behind ?aphase=r10; ?hold=r10 restores the complete round-10 behaviour). Any other rest change is a regression.
(3) ICE renders ring A's joints in the quarters' own frame; it does not change poses.
(4) ${PERF_NOTE}
(5) ${STOP_NOTE} (A judge writes its findings into its WORK/judgeN/verdict_draft.md as it goes.)`

const BUILD = {
  type: 'object',
  properties: {
    lane: { type: 'string' },
    step: { type: 'string' },
    status: { type: 'string', enum: ['done', 'partial', 'blocked'] },
    summary: { type: 'string' },
    files_changed: { type: 'array', items: { type: 'string' } },
    switches: { type: 'array', items: { type: 'string' } },
    assets: { type: 'array', items: { type: 'string' } },
    gates: {
      type: 'array',
      items: {
        type: 'object',
        properties: { gate: { type: 'string' }, status: { type: 'string', enum: ['pass', 'fail', 'unknown'] }, numbers: { type: 'string' } },
        required: ['gate', 'status', 'numbers'],
      },
    },
    evidence: { type: 'array', items: { type: 'string' } },
    open_issues: { type: 'array', items: { type: 'string' } },
  },
  required: ['lane', 'step', 'status', 'summary', 'files_changed', 'gates', 'open_issues'],
}

const VERDICT = {
  type: 'object',
  properties: {
    lane: { type: 'string' },
    pass: { type: 'boolean' },
    lens_score: { type: 'number' },
    gates: {
      type: 'array',
      items: {
        type: 'object',
        properties: { gate: { type: 'string' }, verdict: { type: 'string', enum: ['PASS', 'FAIL'] }, evidence: { type: 'string' } },
        required: ['gate', 'verdict', 'evidence'],
      },
    },
    findings: {
      type: 'array',
      items: {
        type: 'object',
        properties: {
          severity: { type: 'string', enum: ['blocker', 'major', 'minor', 'nit'] },
          title: { type: 'string' },
          evidence: { type: 'string' },
          fix_hint: { type: 'string' },
        },
        required: ['severity', 'title', 'evidence', 'fix_hint'],
      },
    },
    summary: { type: 'string' },
  },
  required: ['lane', 'pass', 'lens_score', 'gates', 'findings', 'summary'],
}

function paths(lane) {
  return 'Your paths: LANE = ' + SP + '/lanes/' + lane.key + ' (git worktree, detached at 7ddac0d, retrux-web/node_modules is a symlink to MAIN\'s), WORK = ' + SP + '/work/' + lane.key +
    ', your lab port = ' + lane.port + ' (start it yourself in the background: cd LANE/retrux-web && PORT=' + lane.port + ' node hero-lab/serve.mjs; stop it before you return). MAIN = ' + MAIN +
    ' (read-only for you; its lab on :5173 is the BASELINE, never stop it). SP = ' + SP + '. The shared heavy-process gate: ' + SLOT + " '<lane>:<what>' -- <cmd> [args...] (max 2 heavy processes machine-wide; release it between batches, never hold it while you think or edit)."
}

function preamble(lane, role) {
  return 'You are a senior real-time graphics engineer and technical artist on the Retrux hero R&D: a real-time three.js (WebGL2) hero, an ice sculpture of four thick ice rings around a glowing plasma orb with cobalt crystal shards, over an arctic lake with snowy mountains, that must match a Blender Cycles reference video frame for frame in look and motion. The user wants 10/10, Awwwards-worthy, matched with the reference, "no mistake", built with their Blender.\n\n' +
    'You work in round 11, lane "' + lane.key + '", as the ' + role + '. FIRST read the binding round document ' + SPEC + ' (sections 0-3 in full, and your lane section ' + lane.section + '). Everything in its section 2 (hard rules) applies to you; the most important: every headless Chrome / Playwright / Blender / build goes through the slot; never save over a .blend in the repo; heavy outputs only in WORK; no git commits, deploys or uploads; every change behind a URL switch that restores the old behaviour exactly; typecheck; keep WORK/LOG.md and LANE/HANDOFF.md; stop the servers you start.\n\n' +
    paths(lane) + '\n\n' +
    'Working style: look at every image you reason about with the Read tool (it displays images); never claim a visual result you did not look at. Measure before and after each change (boxes, diff maps, side-by-sides vs the reference and vs the baseline) and keep a change only if the side-by-side and the numbers both improve and nothing else regresses. Write LOG.md and HANDOFF.md in plain, complete English sentences for other engineers. If you run low on context or time, write your exact state and next steps into WORK/LOG.md and return status "partial".'
}

const LANES = [
  {
    key: 'env',
    port: 5174,
    section: '4.1',
    lens: 'environment (sky, mountains, ridge, massif, icebergs, floes, rocks, lake) at rest and from every camera the visitor can cause',
    steps: [
      {
        name: 'env-bake',
        task: 'YOUR STEP (1 of 2): SPEC 4.1 work items 1, 2, 3 and 5. Port the bake pipeline to macOS with Cycles on the Metal GPU, find the root cause of every v8 defect the SPEC lists (with evidence), produce bake v9 at higher quality and publish it into LANE/retrux-web/public/hero so your lane lab shows it by default; verify gate E-G1 at rest as you go (your lab vs the baseline :5173 and vs the reference F000 / loop F045). Also render, in Blender, the world-only Nishita sky equirect for the lake mirror (pipeline/render_sky_equirect.py, A1 R8) and the summit wisp RGBA card (A1 #2), saved in WORK (the next step wires them into the engine). Work item 4 (engine baked path: planar lake, sky dome, wisp, perf) belongs to the next step, but a shader fix that a bake defect needs is yours.\n' +
          'Start by reading: notes/rebuild_analysis/A1_env_audit.md (all of it), pipeline/bake_env_m8.py, env_repair.py, export_env_v4.py, render_plates_v3.py, render_sky_equirect.py, run_bake_m8.ps1, finalize_bake_m8.ps1 (all under LANE), blender/bake_v8/bake_log.txt and env_baked.json, and the BAKED_ENV code in retrux-web/app/hero/engine/world/PlateEnvironment.ts and assets.ts. The plates were rendered from blender/plate_scene_v7.blend with the cameras in blender/plates_v7/plate_*.json; project from the EXR plates, never the WebPs. If you add plate cameras, build them like render_plates_v3.py and use the same render settings so new plates match the old ones (check their overlap numerically before you use them). Time-box Blender runs, keep RAM in mind (the user is working on this Mac), and prove each pipeline change on a small subset before a full bake.',
      },
      {
        name: 'env-engine',
        task: 'YOUR STEP (2 of 2): SPEC 4.1 work item 4 and all four gates E-G1..E-G4. Read LANE/HANDOFF.md and WORK/LOG.md first (the previous step: bake v9, the sky equirect and the wisp card). Bring the engine\'s baked path to production quality: the lake as a true planar mirror in baked mode (the baked environment, cloud cards and a sky dome from the world-only equirect rendered into a mirror target; keep the ripple bump, the hero\'s reflection, the glint and the orb terms; the projected path keeps today\'s Water code bit-identical), the wisp card, region masks via the rest camera (A1 3.7), DOF as a mip bias, and no projection-only GPU work in baked mode (depth bakes, occlusion fill, extra projectors). If bake defects remain, fix them (re-bake if needed). Then run every gate yourself: shoot_qc (q00,q01,q03,p04,p05,p06,p07,p08), shoot_pointer (all 10 spots), shoot_sweep, perf_probe, each vs the baseline :5173 (and ?env=projected on your lab for E-G4); fix what you find.' + ENV2_NOTE,
      },
    ],
  },
  {
    key: 'hold',
    port: 5175,
    section: '4.2',
    lens: 'press-and-hold choreography (pop, sustain, release) vs State 2 to 5.mp4 F331-F462, motion continuity and framing',
    steps: [
      {
        name: 'hold-build',
        task: 'YOUR STEP: SPEC 4.2, all gates H-G1..H-G5. Read notes/rebuild_analysis/A2_hold_reference.md and A3_hold_code.md in full first, then retrux-web/app/hero/engine/hero/Rings.ts, Choreography.ts, HeroEngine.ts, CameraRig.ts and config.ts. Look at the reference hold frames (MAIN/refs/hold_frames/F328-F472.jpg, every 4 frames; MAIN/hero-pipeline/reference/ref_F358, F402, F420, F453, F460) and at today\'s engine hold (your lab: MAIN/hero-pipeline/validate/shoot_qc.mjs p04-p08, MAIN/pipeline/probe_holdvar.mjs, probe_holdbounds.mjs, MAIN/hero-pipeline/validate/shoot_holdseq.mjs). Video frame F maps to the engine as: expand phase t = (F - 331) / 30 s (F358 = 0.90, F402 = 2.37, F420 = 2.97); release phase t = (F - 443) / 30 s (F453 = 0.33, F460 = 0.57). Implement the reference arrangement deterministically behind the switch ?hold=r10 (the old behaviour, bit-identical), and iterate with side-by-sides at the A2 section 10 key frames (engine | reference at the same t, measured boxes) until each row passes; then H-G2..H-G5. Keep everything A3 section 6 protects. Think about why the reference reads as a legible exploded opening (A2 section 7) and make sure ours does too in a live, continuous hold, not only at the sampled frames.',
      },
      {
        name: 'hold-build-2',
        task: HOLD2_TASK,
      },
    ],
  },
  {
    key: 'ice',
    port: 5176,
    section: '4.3',
    lens: 'ring ice material, orb and shards (clarity, refraction, internal dark bands, frost, silhouettes, orb core and glow) vs the Cycles reference',
    steps: [
      {
        name: 'ice-twin',
        task: 'YOUR STEP (1 of 2): SPEC 4.3 method steps 1-3 (gate I-G1). Build the Cycles twin in Blender on this Mac (Metal GPU): a COPY of LANE/blender/plate_scene_v7.blend with the hero unhidden and its own artist materials, rings / orb / shards posed exactly as the engine poses them (export world matrices from your lab through window.__hero at q00 = idle tau 0, q03 = tau 1.5, and the hold p06 = expand t 2.97 if you can), the engine\'s rest camera (and the hold camera for p06), 1440x766, AgX as in the file. Validate the twin against MAIN/hero-pipeline/reference/ref_F000.png and loop_F045.png (and ref_F420.png). Render useful diagnostic passes (e.g. ice only with the environment and the orb emission off, the orb alone, no displacement, separated transmission / glossy). Then write WORK/ICE_TARGETS.md: measured targets for the engine in named boxes (mean, sd, edge-band darkness, refraction sharpness, silhouette wobble amplitude; twin, reference and today\'s engine at T1 from your lab at the same pose), ranked by visual impact, with your diagnosis of which engine terms cause each gap (read IceMaterial.ts, Orb.ts, Shards.ts, RenderPipeline.ts, PostChain.ts and the round-10 plan T01, T08, T09, T10, T14, T17, T18, T19 plus its disagreements). Do not change the engine\'s look in this step (debug helpers to dump poses are fine). Read hero-pipeline/research/blender_forensics.md sections 0-3 before you touch Blender.',
      },
      {
        name: 'ice-match',
        task: 'YOUR STEP (2 of 2): SPEC 4.3 method step 4 and gates I-G2..I-G4. Read LANE/HANDOFF.md, WORK/LOG.md and WORK/ICE_TARGETS.md first (the Cycles twin renders and the measured targets from the previous step). Make the engine\'s ice, and the orb and shards as seen through and around it, converge on the twin and the reference: change IceMaterial.ts (and Orb.ts, Shards.ts, RenderPipeline.ts, PostChain.ts only where the look demands), behind the switch ?ice=r10 (the old look, bit-identical). Work from the highest-impact target down; after each change re-measure the boxes at q00, q03 and p06 and look at the crops side by side (engine | twin | reference). Optionally bake per-ring data in Blender (e.g. the chiselled displaced geometry for the silhouettes, normal / roughness maps from Blender\'s exact noise) if it beats the procedural approximation; keep the download small. Then check I-G3 (tumble sweep artefacts, perf_probe T1 and T0) and I-G4.' + ICE2_NOTE,
      },
    ],
  },
]

function buildPrompt(lane, step, prev) {
  const prevTxt = prev.length ? '\n\nThe previous step of your lane returned (JSON):\n' + JSON.stringify(prev[prev.length - 1]).slice(0, 6000) : ''
  return preamble(lane, 'builder (' + step.name + ')') + '\n\n' + step.task + prevTxt +
    '\n\nReturn the structured result: status done / partial / blocked, a summary, files changed, switches, assets (with sizes), gate statuses with numbers, evidence paths and open issues.'
}

function judgePrompt(lane, round) {
  return 'You are an independent, adversarial JUDGE for round 11, lane "' + lane.key + '" of the Retrux hero (a real-time three.js ice-sculpture hero that must match a Blender Cycles reference video; the user demands 10/10 and "no mistake"). Your lens: ' + lane.lens + '.\n\n' +
    'Read ' + SPEC + ' (sections 0-3 and your lane section ' + lane.section + ', whose gates you check). ' + paths(lane) + '\n\n' +
    'The builder\'s claims are in LANE/HANDOFF.md and WORK/LOG.md: read them only to learn what changed and which switches exist; do NOT trust any result in them. Verify every gate yourself from FRESH captures of the lane lab (start it yourself if it is not running and stop it afterwards if you started it) against the baseline lab http://localhost:5173 and the reference frames, using the validators and probes the SPEC lists, always through the slot. Put everything you produce in WORK/judge' + round + '/ and edit nothing else. Look at every image you cite with the Read tool, at full resolution where it matters (cut crops with ffmpeg). Hunt specifically for regressions outside the lane\'s scope and for anything the user would call a glitch.\n\n' +
    LEAD_DECISIONS + '\n\n' +
    'Return: per gate PASS / FAIL with evidence (file paths, pixel boxes, numbers); findings by severity (blocker > major > minor > nit) with exact evidence and a concrete fix hint; lens_score 0-10 for your lens vs the reference (10 = indistinguishable at a glance, nothing an art director would flag; 9 = only an expert notices side by side; 8 = noticeable differences but premium; 7 = clearly different or CG tells; 6 or lower = significant problems; one decimal, strict and honest); pass = true only if every gate is PASS and no blocker, major or minor finding remains. When in doubt, FAIL.' +
    (round === 1 && JUDGE_RESUME[lane.key] ? '\n\n' + JUDGE_RESUME[lane.key] : '')
}

function fixPrompt(lane, v) {
  return preamble(lane, 'fixer') + '\n\nYOUR STEP: the independent judge failed this lane. Read LANE/HANDOFF.md, WORK/LOG.md and the judge\'s files in WORK/judge1/. For every blocker, major and minor finding: reproduce it first with the judge\'s own evidence or probe, fix the root cause, re-verify with fresh captures, and only then move on. Re-run every gate that the judge marked FAIL. Append a "Fix round" section to LOG.md and HANDOFF.md.\n\n' + LEAD_DECISIONS + '\n\nThe judge\'s verdict (JSON):\n' + JSON.stringify(v).slice(0, 12000) +
    '\n\nReturn the structured result (status, summary, files changed, gates with numbers, evidence, open issues).' +
    (FIX_RESUME[lane.key] ? '\n\n' + FIX_RESUME[lane.key] : '')
}

const results = await pipeline(
  LANES,
  async (lane) => {
    const outs = []
    for (const step of lane.steps) {
      const r = await agent(buildPrompt(lane, step, outs), { label: 'build:' + step.name, phase: 'Build', schema: BUILD })
      if (!r) {
        log(step.name + ': no result (agent died or was skipped)')
        break
      }
      outs.push(r)
      log(step.name + ': ' + r.status + ' | ' + String(r.summary).slice(0, 220))
      if (r.status === 'blocked') break
    }
    return outs
  },
  async (outs, lane) => {
    if (!outs.length) return { outs, v: null, skipped: true }
    let v = (lane.key === 'hold' && HOLD_V1) ? HOLD_V1 : await agent(judgePrompt(lane, 1), { label: 'judge:' + lane.key, phase: 'Judge', schema: VERDICT })
    if (!v) v = await agent(judgePrompt(lane, 1), { label: 'judge2:' + lane.key, phase: 'Judge', schema: VERDICT })
    if (v) log('judge ' + lane.key + ': pass=' + v.pass + ' score=' + v.lens_score + ' | ' + String(v.summary).slice(0, 200))
    return { outs, v }
  },
  async (prev, lane) => {
    if (prev.skipped) return { lane: lane.key, outs: prev.outs, verdicts: [], note: 'build produced nothing' }
    const v = prev.v
    if (v && v.pass) return { lane: lane.key, outs: prev.outs, verdicts: [v] }
    const fx = await agent(fixPrompt(lane, v || { note: 'the judge returned nothing; re-verify every gate yourself' }), { label: 'fix:' + lane.key, phase: 'Fix', schema: BUILD })
    if (fx) log('fix ' + lane.key + ': ' + fx.status + ' | ' + String(fx.summary).slice(0, 200))
    const v2 = await agent(judgePrompt(lane, 2), { label: 'rejudge:' + lane.key, phase: 'Fix', schema: VERDICT })
    if (v2) log('rejudge ' + lane.key + ': pass=' + v2.pass + ' score=' + v2.lens_score)
    return { lane: lane.key, outs: prev.outs.concat(fx ? [fx] : []), verdicts: [v, v2].filter(Boolean) }
  },
)

return results
