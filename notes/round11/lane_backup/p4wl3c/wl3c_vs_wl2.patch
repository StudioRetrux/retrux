+      },
+      { find: "      if (Fc > 0.995 || hits > 3.5) break;\n", repl: "      if (Fc > 0.995 || hitsC > 3.5) break;   // wl3c\n" },
+    );
+  return p4Apply(src, e, "WL3AW");
