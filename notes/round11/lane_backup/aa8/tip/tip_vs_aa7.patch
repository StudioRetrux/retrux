+function waterFragTip(src: string) {
+  const i = src.indexOf(LK_FFTIP_ANCHOR);
+  if (i < 0 || src.indexOf(LK_FFTIP_ANCHOR, i + 1) >= 0) throw new Error("Water: AA8 tip anchor");
+  return src.slice(0, i + LK_FFTIP_ANCHOR.length) + LK_FFTIP_GLSL + src.slice(i + LK_FFTIP_ANCHOR.length);
+}
