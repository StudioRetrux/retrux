+/**
+ * AA8 tip (21 Nov, the faint pale spot at the near far floe's thin tip at render scale 1; `?fftip=0` = AA7 exactly: this text
+ * is not in the shader then). Where the floe thins out its face is less than one mirror row tall and runs at a slight slant
+ * across the rows, so the target holds it as a staircase of short steps: on the columns between two steps no row centre lies
+ * on the face (debug renders: the two bracketing rows are the floe's sunlit inside 0.6-1.2 m behind the face's entry and the
+ * far shore, or two inside rows), the guard above has no face row to copy and the lookup stays pale. There the face's own
+ * texels are a few columns to the side in the same two rows: when the front row lies LK_FFTIP_G..+0.15 m (0.35..0.5) or more
+ * behind X's lookup point (fading out over the guard's depth band), the two rows are read 1, 2 .. 6 columns to each side
+ * (LK_FFTIP_S x 1..LK_FFTIP_N; every column: a 2-column stride skipped the one-column steps of the farther floes' faces, which
+ * then flickered as dark dots), and a texel that is the face (path length within LK_FFTIP_W..+0.4 m (0.6..1.0) of X's lookup
+ * point, 0.15..0.3 m in front of the front row, darker than it by LK_FFTIP_L..+0.1 (0.25..0.35) luma) gives the lookup its
+ * colour, nearest columns first. Only the lookup's colour changes, and only toward a face texel. The same row starvation
+ * leaves smaller pale patches under the farther floes' feet; they go the same way (toward the image with twice the rows).
+ */
+const LK_FFTIP_ANCHOR = "            cF = mix(cF, mix(c0, c1, vR - j0), gFt);\n";
+const LK_FFTIP_END = "            // (AA8 tip end)\n";
+const LK_FFTIP_GLSL = /* glsl */ `            {
+              float dXt = distance(uMirrorCamPos, X + vec3(0.0, y0 + hM, 0.0));
+              float gI = smoothstep(LK_FFTIP_G, LK_FFTIP_G + 0.15, pm - dXt) * (1.0 - smoothstep(LK_FFBD0, LK_FFBD1, pm - dXt));
+#if LK_FFTIP_B == 1
+              // only a front row whose centre lies past X's foot line on the under-water side (the target's "up" is toward uvM):
+              // its line of sight enters the floe through the clip at the water line, so it shows the inside, never the face (a
+              // sunlit face standing behind X, above the line, keeps its colour: else dark dots in the far floes' light columns)
+              float fRw = uvFt.y * uEnvMirrorSize.y;
+              float sUp = sign(clamp(uvM.y, 0.0005, 0.9995) * uEnvMirrorSize.y - fRw);
+              gI *= smoothstep(0.0, 0.25, (fRw - (r0.a <= r1.a ? j0 + 0.5 : j0 + 1.5)) * sUp);
+#endif
+              if (gI > 0.0) {
+                vec3 cT = vec3(0.0);
+                float kT = 0.0;
+                for (int s = 1; s <= LK_FFTIP_N; s++) {
+                  for (int q = 0; q < 4; q++) {
+                    float o = float(s) * LK_FFTIP_S * (q < 2 ? -1.0 : 1.0) / uEnvMirrorSize.x;
+                    float jr = (q == 0 || q == 2) ? j0 + 0.5 : j0 + 1.5;
+                    vec4 rq = textureGrad(uEnvMirror, vec2(clamp(ux + o, 0.0005, 0.9995), jr / uEnvMirrorSize.y), dxF, vec2(0.0));
+                    float wq = (1.0 - smoothstep(LK_FFTIP_W, LK_FFTIP_W + 0.4, abs(rq.a - dXt))) * smoothstep(0.15, 0.3, pm - rq.a) * smoothstep(LK_FFTIP_L, LK_FFTIP_L + 0.1, lN - dot(rq.rgb, lW));
+                    float aq = wq * (1.0 - kT);
+                    cT += aq * rq.rgb;
+                    kT += aq;
