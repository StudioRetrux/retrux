+// lake's distance) between a solid and the lake behind it
+uniform vec3 uMlaaP;
+// x: 1 = Z shapes only (a straight line's step at both ends; no U / L shapes, which round corners and bumps),
+// y: 1 = the pixel's current coverage from its colour (linear in the compressed space) instead of its alpha
+uniform vec2 uMlaaQ;
+float mlTw(ivec2 q) {
+  vec3 d = taaRay(vec2(q) + 0.5);
+  return d.y < -1e-5 * length(d) ? -uCamPos.y * length(d) / d.y : -1.0;
+}
+float mlA(ivec2 q) {
+  return texelFetch(uCur, clamp(q, ivec2(0), ivec2(uSize) - 1), 0).a;
+}
+// the lake fraction of pixel q (its alpha between the solid's distance dS and its lake point's)
+float mlF(ivec2 q, float dS) {
+  float a = mlA(q), tw = mlTw(q);
+  if (a <= 1.0 || tw <= 0.0) return 0.0;
+  return clamp((a - dS) / max(tw - dS, 1e-3), 0.0, 1.0);
+}
+// a solid clearly in front of the lake point of its ray (or above the horizon)
+bool mlSolid(ivec2 q, float a) {
